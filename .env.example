# Copy this file to .env and fill in the values. .env is gitignored.
# On a Cursor cloud agent, add these same names as secrets. Do not commit the values.

# Sportcast admin UI. Required.
SCL_UI_USERNAME=
SCL_UI_PASSWORD=
# Optional. Defaults to https://sportcastlive.com
SCL_UI_BASE_URL=https://sportcastlive.com

# Datadog, Sportcast site. Required before a ticket can be resolved.
DD_API_KEY=
DD_APPLICATION_KEY=
# Optional.
# DD_SITE_URL=https://openbet-feeds-sportcast.datadoghq.com

# Jira Cloud. Required for the tool to fetch the ticket and transition it.
JIRA_BASE_URL=https://openbet.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
